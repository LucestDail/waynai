# ============================================================
# WaynAI 환경변수 템플릿
# ============================================================
# 1) 이 파일을 복사하여 `.env` 를 만드세요: cp .env.example .env
# 2) 각 키를 발급받아 채워 넣으세요.
# 3) `.env` 는 절대로 커밋하지 마세요 (.gitignore 포함됨).
# ------------------------------------------------------------

# ---- OpenRouter (OpenAI 호환 LLM) ----
# https://openrouter.ai/keys 에서 발급
OPENROUTER_API_KEY=

# 모델 호출 우선순위 (저가 → 고가). 실패 시 다음 모델로 핫스왑 fallback.
# OpenRouter 슬러그 형식. 원하는 모델로 교체하세요.
# 저가 고성능(중국산) 조합 — 출력 단가 저렴 순. 원하는 모델로 교체 가능.
OPENROUTER_MODEL_CHAIN=deepseek/deepseek-v3.2,z-ai/glm-4.7-flash,deepseek/deepseek-chat

# (로컬 개발 전용) 사내 MITM 프록시로 TLS 검증 실패 시 true. 운영은 false.
GEMINI_TLS_INSECURE=false

# ---- 네이버 검색 API ----
# https://developers.naver.com/apps 에서 애플리케이션 등록 후 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ---- 한국관광공사 공공데이터 서비스 키 ----
# https://www.data.go.kr/ 에서 활용 신청 후 발급
# ⚠️ 반드시 "Decoding(원문)" 값을 넣으세요. (내부에서 자동으로 URL 인코딩함)
# 값에 +, /, = 이 포함되므로 따옴표로 감싸는 것을 권장합니다.
#   예) TOUR_API_SERVICE_KEY="+kU/l+mB...원문...=="
TOUR_API_SERVICE_KEY=

# ---- Travelpayouts (항공권 가격 / 제휴) ----
# https://www.travelpayouts.com 가입 후 Developers → API token 발급.
# 미설정 시 항공권 조회 기능만 자동 비활성화됨 (나머지는 정상 동작).
TRAVELPAYOUTS_TOKEN=
# (선택) 제휴 마커 — 예약 링크 커미션 트래킹용. 대시보드 상단 숫자.
TRAVELPAYOUTS_MARKER=
# (선택) 기본 출발지 IATA / 통화. 통화 미지원 시 usd 로 변경.
TRAVELPAYOUTS_DEFAULT_ORIGIN=SEL
TRAVELPAYOUTS_CURRENCY=krw

# ---- OpenRouteService (실제 이동시간/거리) ----
# https://openrouteservice.org 가입 후 무료 키. 미설정 시 이동시간 계산만 비활성.
ORS_API_KEY=

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 서버 ----
SERVER_PORT=8080

# ---- 프론트엔드 (Vite) ----
VITE_API_BASE_URL=http://localhost:8080

# ---- Tavily 웹 검색 (해외 여행 정보 강화) ----
# https://tavily.com 가입 후 무료 키. 미설정 시 웹 검색만 비활성.
TAVILY_API_KEY=
